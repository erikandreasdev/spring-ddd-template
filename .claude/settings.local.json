{
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(mvn *)",
      "Bash(./mvnw *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ],
    "ask": [
      "Edit(/CLAUDE.local.md)",
      "Edit(/.claude/**)",
      "Edit(/src/test/java/**/ArchitectureTest.java)",
      "Edit(/pom.xml)"
    ],
    "deny": [
      "Bash(git commit *)",
      "Bash(git push *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/architecture-check.sh\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
