@startuml context-map
' Mapa de contextos: solo cuando hay dos o más. Un componente por contexto y una flecha por
' relación, en el sentido de la dependencia, con lo que se intercambia.
title Mapa de contextos

component "orders" as orders
component "customers" as customers
component "Proveedor de pagos\n(externo)" as payments #EEEEEE

orders --> customers : referencia CustomerId
orders --> payments : PaymentGateway\n(cobro por HTTP)
@enduml
